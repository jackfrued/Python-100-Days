    "# 数字求和：通过用户输入两个数字，并计算两个数字之和：\n",
    "num1 = input(\"请输入第一个数字：\")\n",
    "num2 = input(\"请输入第二个数字：\")\n",
    "sum = float(num1) + float(num2)\n",
    "print(f\"数字{num1}和数字{num2}相加的结果为{sum}。\")"
